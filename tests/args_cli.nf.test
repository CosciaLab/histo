// The sopa CLI flags built from params.

nextflow_function {

    name "argsCLI"
    script "../modules/local/utils.nf"
    function "argsCLI"
    tag "unit"
    tag "validation"

    test("projection hands Cellpose the cell channel, then the nuclear one") {
        when {
            function {
                """
                input[0] = "cellpose"
                input[1] = [ use_projection: true, cellpose_channels: null ]
                """
            }
        }
        then {
            assert function.success
            assert function.result.contains("--channels 'cell' --channels 'nuclear'")
        }
    }

    test("without projection, cellpose_channels is passed through") {
        when {
            function {
                """
                input[0] = "cellpose"
                input[1] = [ use_projection: false, cellpose_channels: 'DNA_6' ]
                """
            }
        }
        then {
            assert function.success
            assert function.result.contains("--channels 'DNA_6'")
        }
    }

    test("diameter is fixed at 30, cpsam's native size, and model_type is not passed") {
        when {
            function {
                """
                input[0] = "cellpose"
                input[1] = [ use_projection: false, cellpose_channels: 'DNA_6', cellpose_diameter: 15, cellpose_model_type: 'cyto3' ]
                """
            }
        }
        then {
            assert function.success
            assert function.result.contains("--diameter 30")
            assert !function.result.contains("--model-type")
        }
    }

    test("no GPU or device flag: the module adds it from the task's GPU request") {
        when {
            function {
                """
                input[0] = "cellpose"
                input[1] = [ use_projection: false, cellpose_channels: 'DNA_6', use_gpu: true, cellpose_use_gpu: true ]
                """
            }
        }
        then {
            assert function.success
            assert !function.result.contains("gpu")
        }
    }

    test("InstanSeg gets no device flag from params") {
        when {
            function {
                """
                input[0] = "instanseg"
                input[1] = [ instanseg_pixel_size: 0.65, use_gpu: true, instanseg_device: 'cuda' ]
                """
            }
        }
        then {
            assert function.success
            assert !function.result.contains("--device")
        }
    }
}
