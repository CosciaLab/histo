// The sopa CLI flags built from params. Segmentation and aggregation take spec maps instead
// (segmentation_specs.nf.test).

nextflow_function {

    name "argsCLI"
    script "../modules/local/utils.nf"
    function "argsCLI"
    tag "unit"
    tag "validation"

    test("image_patches passes the patch width and overlap") {
        when {
            function {
                """
                input[0] = "image_patches"
                input[1] = [ patch_width_pixel: 2000, patch_overlap_pixel: 100 ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == "--patch-width-pixel 2000 --patch-overlap-pixel 100"
        }
    }

    test("tissue_segmentation leaves unset params out") {
        when {
            function {
                """
                input[0] = "tissue_segmentation"
                input[1] = [ level: 2, mode: null, tissue_segmentation_kwargs: null ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == "--level 2"
        }
    }

    test("the per-backend groups are gone") {
        when {
            function {
                """
                input[0] = "cellpose"
                input[1] = [ use_cellpose: true, cellpose_channels: 'DNA_6' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("Unknown argument group: cellpose") }
        }
    }
}
