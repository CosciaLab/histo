// Channel projection end to end under -stub: the projection is added before patching and
// dropped by WRITE_SEGMENTATIONS. -profile laptop puts tests/stub_bin on PATH for ashlar.

nextflow_pipeline {

    name "Channel projection"
    script "../main.nf"
    profile "test,laptop"
    options "-stub"
    tag "stub"
    tag "pipeline"

    test("projection runs between tissue segmentation and patching, once per sample") {

        when {
            // Absolute paths, since nf-test launches from its own directory.
            def data = "$baseDir/tests/stub_data"
            def sheet = new File("$outputDir", "samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,cycle_number,image_tiles,marker_sheet\n" +
                "testsample,1,${data}/cycle01.ome.tiff,${data}/markers.csv\n" +
                "testsample,2,${data}/cycle02.ome.tiff,${data}/markers.csv\n"

            params {
                outdir = "$outputDir"
                input = sheet.path
                use_preprocessing = true
                use_projection = true
                // conf/test.config sets 'DAPI'; projection supplies the channels itself.
                cellpose_channels = null
            }
        }

        then {
            def ran = workflow.trace.succeeded().collect { it.name }
            def names = { proc -> ran.findAll { it.contains(proc) } }

            assertAll(
                { assert workflow.success },
                { assert names("PROJECT_CHANNELS").size() == 1 },
                { assert names("SEGMENT_PATCH_CELLPOSE").size() == 2 },
                { assert names("AGGREGATE").size() == 1 },
                { assert names("WRITE_SEGMENTATIONS").size() == 1 },
                { assert names("QC_REPORT").size() == 1 },
                { assert path("$outputDir/qc/testsample_projection.png").exists() },
                { assert path("$outputDir/qc/testsample_projection.json").exists() },
                // Only the preview is QC; a copy of the store there would double its disk use.
                { assert !path("$outputDir/qc/testsample.zarr").exists() },

                // A missing entry means a module lost its version capture.
                { assert path("$outputDir/pipeline_info/histo_software_versions.yml").text.contains('PROJECT_CHANNELS') },
                { assert path("$outputDir/pipeline_info/histo_software_versions.yml").text.contains('WRITE_SEGMENTATIONS') }
            )
        }
    }
}
