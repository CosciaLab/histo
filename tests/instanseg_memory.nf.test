// The memory each InstanSeg patch task asks for, and the patch width the warning suggests.

nextflow_function {

    name "instansegMemoryGB"
    script "../modules/local/utils.nf"
    tag "unit"
    tag "validation"

    test("5 channels on a 3000 px patch at 0.65 µm/px ask for 25 GB") {
        function "instansegMemoryGB"
        when {
            function {
                """
                input[0] = 5
                input[1] = 3000
                input[2] = 0.65
                """
            }
        }
        then {
            assert function.success
            // Peaked at 18.6 GB on a 2900 px core (test7 07).
            assert function.result == 25
        }
    }

    test("37 channels on the same patch ask for 171 GB") {
        function "instansegMemoryGB"
        when {
            function {
                """
                input[0] = 37
                input[1] = 3000
                input[2] = 0.65
                """
            }
        }
        then {
            assert function.success
            // Peaked at 132 GB on a 2900 px core (test7 11).
            assert function.result == 171
        }
    }

    test("the suggested width for 37 channels keeps the request within 64 GB") {
        function "instansegMaxPatchWidth"
        when {
            function {
                """
                input[0] = 37
                input[1] = 64
                input[2] = 0.65
                """
            }
        }
        then {
            assert function.success
            // 1800 px asks for 63 GB; 1900 would ask for 70.
            assert function.result == 1800
        }
    }

    // Command-line values arrive as Strings; "5000" * 0.65 would be string repetition.
    test("command-line Strings give the same request as numbers") {
        function "instansegMemoryGB"
        when {
            function {
                """
                input[0] = 1
                input[1] = '5000'
                input[2] = '0.65'
                """
            }
        }
        then {
            assert function.success
            // (5000 * 0.65 / 0.5)^2 = 42.25 MP at 1.3 GB/MP, plus 2: 56.9.
            assert function.result == 57
        }
    }

    test("command-line Strings give the same suggested width as numbers") {
        function "instansegMaxPatchWidth"
        when {
            function {
                """
                input[0] = 37
                input[1] = 64
                input[2] = '0.65'
                """
            }
        }
        then {
            assert function.success
            assert function.result == 1800
        }
    }

    test("a pixel size that is not a number fails naming the parameter") {
        function "instansegMemoryGB"
        when {
            function {
                """
                input[0] = 1
                input[1] = 5000
                input[2] = 'abc'
                """
            }
        }
        then {
            assert function.failed
            def out = function.stdout.toString() + function.stderr.toString()
            assert out.contains("instanseg_pixel_size must be a number, got 'abc'")
        }
    }
}
