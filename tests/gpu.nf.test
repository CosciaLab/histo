// use_gpu under -stub: conf/gpu.config is included and the pipeline still wires up. The GPU
// request, --nv and the CUDA check only act on a real cluster run, for Cellpose and InstanSeg.

nextflow_pipeline {

    name "GPU segmentation"
    script "../main.nf"
    profile "test,laptop"
    options "-stub"
    tag "stub"
    tag "pipeline"

    test("use_gpu runs Cellpose once per patch, as without it") {

        when {
            params {
                outdir = "$outputDir"
                use_gpu = true
            }
        }

        then {
            def ran = workflow.trace.succeeded().collect { it.name }
            def names = { proc -> ran.findAll { it.contains(proc) } }

            assertAll(
                { assert workflow.success },
                { assert names("SEGMENT_PATCH_CELLPOSE").size() == 2 },
                { assert names("RESOLVE").size() == 1 },

                // A missing entry means the module lost its version capture.
                { assert path("$outputDir/pipeline_info/histo_software_versions.yml").text.contains('SEGMENT_PATCH_CELLPOSE') }
            )
        }
    }

    test("use_gpu with InstanSeg runs both methods once per patch, without the CPU fallback") {

        when {
            params {
                outdir = "$outputDir"
                use_gpu = true
                use_instanseg = true
                instanseg_pixel_size = 0.65
                instanseg_channels = "DAPI"
            }
        }

        then {
            def ran = workflow.trace.succeeded().collect { it.name }
            def names = { proc -> ran.findAll { it.contains(proc) } }
            // log.warn reaches .nextflow.log, not the stdout nf-test captures.
            def log = new File("$metaDir/nextflow.log").text

            assertAll(
                { assert workflow.success },
                { assert names("SEGMENT_PATCH_CELLPOSE").size() == 2 },
                { assert names("SEGMENT_PATCH_INSTANSEG").size() == 2 },
                { assert !log.contains("InstanSeg runs on CPU") }
            )
        }
    }
}
