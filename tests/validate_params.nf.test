// Parameter combinations that would otherwise fail late or obscurely.

nextflow_function {

    name "validateParams"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "validateParams"
    tag "unit"
    tag "validation"

    test("projection with Cellpose on a marker-sheet run is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: true, cellpose_channels: null ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("projection on pre-stitched input is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: false, use_projection: true ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_projection requires use_preprocessing") }
        }
    }

    test("projection with cellpose_channels also set is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: true, cellpose_channels: 'DAPI' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("cellpose_channels must be unset") }
        }
    }

    test("neither method is rejected, naming both") {
        when {
            function {
                """
                input[0] = [ use_cellpose: false, use_instanseg: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_cellpose") && it.contains("use_instanseg") }
        }
    }

    test("both methods with use_gpu are accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', use_instanseg: true, instanseg_pixel_size: 0.65,
                             instanseg_channels: 'DAPI', use_gpu: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("use_gpu with 10 instanseg_channels is accepted") {
        when {
            function {
                """
                input[0] = [ use_instanseg: true, instanseg_pixel_size: 0.65, use_gpu: true,
                             instanseg_channels: (1..10).collect { "M\$it" }.join(' ') ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("use_gpu with 11 instanseg_channels is rejected") {
        when {
            function {
                """
                input[0] = [ use_instanseg: true, instanseg_pixel_size: 0.65, use_gpu: true,
                             instanseg_channels: (1..11).collect { "M\$it" }.join(' ') ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("at most 10 channels") && it.contains("names 11") }
        }
    }

    test("keep_projection without use_projection is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: false, keep_projection: true ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("keep_projection requires use_projection") }
        }
    }

    test("with both targets off there is nothing to segment") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false, segment_nuclei: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("At least one of segment_cells and segment_nuclei") }
        }
    }

    test("segment_nuclei with cells is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, segment_nuclei: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("segment_nuclei as the text 'true' counts as a target") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false, segment_nuclei: 'true' ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("with segment_cells false and segment_nuclei unset there is nothing to segment") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("At least one of segment_cells and segment_nuclei") }
        }
    }

    test("segment_nuclei alone is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false, segment_nuclei: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("TMA sweep without expected cores or diameter is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, use_preprocessing: true, use_tma_dearray: true ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("tma_expected_cores") && it.contains("tma_core_diameter_mm") && it.contains("coreograph_args") }
        }
    }

    test("TMA sweep with zero expected cores is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, use_preprocessing: true, use_tma_dearray: true, tma_expected_cores: 0, tma_core_diameter_mm: 1.5 ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("tma_expected_cores must be greater than 0") }
        }
    }

    test("TMA sweep with a negative diameter is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, use_preprocessing: true, use_tma_dearray: true, tma_expected_cores: 4, tma_core_diameter_mm: -1 ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("tma_core_diameter_mm must be greater than 0") }
        }
    }

    test("TMA sweep with both values is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, use_preprocessing: true, use_tma_dearray: true, tma_expected_cores: 4, tma_core_diameter_mm: 1.5 ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("manual coreograph_args needs no tma params") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, use_preprocessing: true, use_tma_dearray: true, coreograph_args: '--downsampleFactor 4' ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("default statistics are accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, quantification_statistics: 'mean,median,std' ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("statistics without mean are rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, quantification_statistics: 'median,std' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("quantification_statistics must include mean") }
        }
    }

    test("duplicate statistics are rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, quantification_statistics: 'mean,mean' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("quantification_statistics lists mean twice") }
        }
    }
}
