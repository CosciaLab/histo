// Parameter combinations that would otherwise fail late or obscurely.

nextflow_function {

    name "validateParams"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "validateParams"
    tag "unit"
    tag "validation"

    test("projection with Cellpose on a marker-sheet run is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: true, cellpose_channels: null ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("projection on pre-stitched input is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: false, use_projection: true ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_projection requires use_preprocessing") }
        }
    }

    test("projection with cellpose_channels also set is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: true, cellpose_channels: 'DAPI' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("cellpose_channels must be unset") }
        }
    }

    test("neither method is rejected, naming both") {
        when {
            function {
                """
                input[0] = [ use_cellpose: false, use_instanseg: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_cellpose") && it.contains("use_instanseg") }
        }
    }

    test("both methods with use_gpu are accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', use_instanseg: true, instanseg_pixel_size: 0.65,
                             instanseg_channels: 'DAPI', use_gpu: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("keep_projection without use_projection is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_projection: false, keep_projection: true ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("keep_projection requires use_projection") }
        }
    }

    test("with both targets off there is nothing to segment") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false, segment_nuclei: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("At least one of segment_cells and segment_nuclei") }
        }
    }

    test("segment_nuclei with cells is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: true, segment_nuclei: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("segment_nuclei alone is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, cellpose_channels: 'DAPI', segment_cells: false, segment_nuclei: true ]
                """
            }
        }
        then {
            assert function.success
        }
    }
}
