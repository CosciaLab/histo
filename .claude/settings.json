{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/tools/schema_lint_hook.sh",
                        "timeout": 60,
                        "statusMessage": "Linting nextflow_schema.json"
                    }
                ]
            }
        ]
    }
}
