%%metro title: CosciaLab/histo
%%metro style: light
%%metro line: wsi | Whole slide | #2a78d6
%%metro line: tma | Tissue microarray | #1baf7a
%%metro marker: BACKSUB | circle, #cccccc
%%metro marker: PROJECT_CHANNELS | circle, #cccccc
%%metro marker: LINK_COMPARTMENTS | circle, #cccccc
%%metro marker: COMPARE_SEGMENTATIONS | circle, #cccccc
%%metro marker_legend: circle, #cccccc | Optional step
%%metro legend: bl
%%metro grid: preprocessing | 0,0
%%metro grid: store | 1,0
%%metro grid: segmentation | 2,0
%%metro grid: output | 2,1
%%metro grid: qc | 2,2

graph LR
    subgraph preprocessing [Preprocessing]
        BASICPY([Illumination (BaSiCPy)])
        ASHLAR([Stitch + register (Ashlar)])
        COREOGRAPH([TMA dearray (Coreograph)])
        BACKSUB([Background subtraction])

        BASICPY -->|wsi, tma| ASHLAR
        ASHLAR -->|tma| COREOGRAPH
        ASHLAR -->|wsi| BACKSUB
        COREOGRAPH -->|tma| BACKSUB
    end

    subgraph store [SpatialData]
        TO_SPATIALDATA([SpatialData + patches])
    end

    subgraph segmentation [Segmentation]

        PROJECT_CHANNELS([Channel projection])
        SEGMENT_PATCH_CELLPOSE([Cellpose-SAM])
        SEGMENT_PATCH_INSTANSEG([InstanSeg])
        LINK_COMPARTMENTS([Link nucleus ↔ cell])
        AGGREGATE([Quantify per cell])

        PROJECT_CHANNELS -->|wsi, tma| SEGMENT_PATCH_CELLPOSE
        SEGMENT_PATCH_CELLPOSE -->|wsi, tma| LINK_COMPARTMENTS
        SEGMENT_PATCH_INSTANSEG -->|wsi, tma| LINK_COMPARTMENTS
        LINK_COMPARTMENTS -->|wsi, tma| AGGREGATE
    end

    subgraph output [Output]
        %%metro direction: RL
        MERGE_SPATIALDATA([Merge cores per slide])
        PUBLISH_SPATIALDATA([Publish SpatialData])

        MERGE_SPATIALDATA -->|tma| PUBLISH_SPATIALDATA
    end

    subgraph qc [Quality control]

        QC_METRICS([QC metrics + images])
        QC_REPORT([QC report])
        COMPARE_SEGMENTATIONS([Compare segmentations])
        MERGE_REPORT([Slide QC report])

        QC_METRICS -->|wsi, tma| QC_REPORT
        QC_REPORT -->|wsi, tma| COMPARE_SEGMENTATIONS
        COMPARE_SEGMENTATIONS -->|tma| MERGE_REPORT
    end

    BACKSUB -->|wsi, tma| TO_SPATIALDATA
    TO_SPATIALDATA -->|wsi, tma| PROJECT_CHANNELS
    TO_SPATIALDATA -->|wsi, tma| SEGMENT_PATCH_INSTANSEG
    AGGREGATE -->|wsi| PUBLISH_SPATIALDATA
    AGGREGATE -->|tma| MERGE_SPATIALDATA
    PUBLISH_SPATIALDATA -->|wsi, tma| QC_METRICS

    %% Two lines, three rows: left to right, back right to left, then left to right again.
    %% Grey stations are optional steps. Grouped stations:
    %%   COREOGRAPH       COREOGRAPH_DETECT, COREOGRAPH_SELECT, COREOGRAPH
    %%   TO_SPATIALDATA   TO_SPATIALDATA, SET_CHANNEL_NAMES, MAKE_IMAGE_PATCHES
    %%   AGGREGATE        RESOLVE, AGGREGATE, WRITE_SEGMENTATIONS
    %%   QC_METRICS       QC_METRICS, QC_IMAGES
    %% Schematic, not wiring: QC reads the store alongside publishing, not after it.
    %% Edges left out are described in docs/CONTRIBUTING.md#what-the-map-leaves-out.
