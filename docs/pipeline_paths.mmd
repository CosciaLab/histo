%%metro title: CosciaLab/histo: three paths through the pipeline
%%metro style: light
%%metro line: backsub | WSI: background subtracted, Cellpose cells | #eb6834
%%metro line: mif | mIF slide: Cellpose + InstanSeg, cells + nuclei | #2a78d6
%%metro line: tma | TMA: dearrayed, InstanSeg cells + nuclei | #1baf7a
%%metro grid: preprocessing | 0,0
%%metro grid: store | 1,0
%%metro grid: segmentation | 2,0
%%metro grid: output | 2,1
%%metro grid: qc | 1,1
%%metro legend: bl

graph LR
    subgraph preprocessing [Preprocessing]
        BASICPY([Illumination (BaSiCPy)])
        ASHLAR([Stitch + register (Ashlar)])
        BACKSUB([Background subtraction])
        COREOGRAPH([TMA dearray (Coreograph)])
        _MIF([ ])

        BASICPY -->|mif, backsub, tma| ASHLAR
        ASHLAR -->|backsub| BACKSUB
        ASHLAR -->|tma| COREOGRAPH
        ASHLAR -->|mif| _MIF
    end

    subgraph store [SpatialData]
        TO_SPATIALDATA([SpatialData + patches])
    end

    subgraph segmentation [Segmentation]
        SEGMENT_PATCH_CELLPOSE([Segment: Cellpose-SAM])
        SEGMENT_PATCH_INSTANSEG([Segment: InstanSeg])
        LINK_COMPARTMENTS([Link nucleus ↔ cell])
        AGGREGATE([Quantify per cell])

        SEGMENT_PATCH_CELLPOSE -->|mif| LINK_COMPARTMENTS
        SEGMENT_PATCH_CELLPOSE -->|backsub| AGGREGATE
        SEGMENT_PATCH_INSTANSEG -->|mif, tma| LINK_COMPARTMENTS
        LINK_COMPARTMENTS -->|mif, tma| AGGREGATE
    end

    subgraph output [Output]
        %%metro direction: RL
        %%metro entry: top | mif, backsub, tma
        MERGE_SPATIALDATA([Merge cores per slide])
        PUBLISH_SPATIALDATA([Publish SpatialData])

        MERGE_SPATIALDATA -->|tma| PUBLISH_SPATIALDATA
    end

    subgraph qc [Quality control]
        %%metro direction: RL
        %%metro entry: top | mif, backsub, tma
        QC_METRICS([QC metrics + images])
        QC_REPORT([QC report])
        COMPARE_SEGMENTATIONS([Compare segmentations])
        MERGE_REPORT([Merge QC reports per slide])

        QC_METRICS -->|mif, backsub, tma| QC_REPORT
        QC_METRICS -->|mif| COMPARE_SEGMENTATIONS
        QC_METRICS -->|tma| MERGE_REPORT
    end

    _MIF -->|mif| TO_SPATIALDATA
    BACKSUB -->|backsub| TO_SPATIALDATA
    COREOGRAPH -->|tma| TO_SPATIALDATA
    TO_SPATIALDATA -->|mif, backsub| SEGMENT_PATCH_CELLPOSE
    TO_SPATIALDATA -->|mif, tma| SEGMENT_PATCH_INSTANSEG
    AGGREGATE -->|mif, backsub| PUBLISH_SPATIALDATA
    AGGREGATE -->|tma| MERGE_SPATIALDATA
    AGGREGATE -->|mif, backsub, tma| QC_METRICS

    %% Stations group processes, so the map reads at a glance:
    %%   COREOGRAPH       COREOGRAPH_DETECT, COREOGRAPH_SELECT, COREOGRAPH
    %%   TO_SPATIALDATA   TO_SPATIALDATA, SET_CHANNEL_NAMES, MAKE_IMAGE_PATCHES
    %%   AGGREGATE        RESOLVE, AGGREGATE, WRITE_SEGMENTATIONS
    %%   QC_METRICS       QC_METRICS, QC_IMAGES
    %% _MIF is a hidden waypoint that keeps the mIF line straight; without it
    %% nf-metro 1.1.0 draws a doubled detour under BACKSUB.
    %%
    %% Edges left out, described in docs/CONTRIBUTING.md#what-the-map-leaves-out:
    %% the pre-subtraction image and Ashlar's QC directory reaching QC. COMPARE_SEGMENTATIONS
    %% reads the store; it hangs off QC_METRICS only to stay inside the QC section.
    %%
    %% The segmentation on each line is an example: any methods and targets fit any line.
