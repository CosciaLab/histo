%%metro title: CosciaLab/histo: three paths through the pipeline
%%metro style: light
%%metro line: mif | mIF slide, both methods, cells and nuclei | #2a78d6
%%metro line: backsub | WSI, background subtracted, Cellpose cells | #eb6834
%%metro line: tma | TMA, dearrayed, InstanSeg cells and nuclei | #1baf7a

graph LR
    subgraph preprocessing [Preprocessing]
        BASICPY([Illumination correction])
        ASHLAR([Stitching and registration])
        BACKSUB([Background subtraction])
        COREOGRAPH_DETECT([Core detection sweep])
        COREOGRAPH_SELECT([Pick downsample factor])
        COREOGRAPH([TMA dearray])

        BASICPY -->|mif, backsub, tma| ASHLAR
        ASHLAR -->|backsub| BACKSUB
        ASHLAR -->|tma| COREOGRAPH_DETECT
        COREOGRAPH_DETECT -->|tma| COREOGRAPH_SELECT
        COREOGRAPH_SELECT -->|tma| COREOGRAPH
    end

    subgraph store [SpatialData store]
        TO_SPATIALDATA([Convert to SpatialData])
        SET_CHANNEL_NAMES([Name channels])
        MAKE_IMAGE_PATCHES([Cut into patches])

        TO_SPATIALDATA -->|mif, backsub, tma| SET_CHANNEL_NAMES
        SET_CHANNEL_NAMES -->|mif, backsub, tma| MAKE_IMAGE_PATCHES
    end

    subgraph segmentation [Segmentation]
        SEGMENT_PATCH_CELLPOSE([Cellpose])
        SEGMENT_PATCH_INSTANSEG([InstanSeg])
        RESOLVE([Join patches])
        LINK_COMPARTMENTS([Link nuclei and cells])
        AGGREGATE([Quantify markers])
        WRITE_SEGMENTATIONS([Write outlines])

        SEGMENT_PATCH_CELLPOSE -->|mif, backsub| RESOLVE
        SEGMENT_PATCH_INSTANSEG -->|mif, tma| RESOLVE
        RESOLVE -->|mif, tma| LINK_COMPARTMENTS
        RESOLVE -->|backsub| AGGREGATE
        LINK_COMPARTMENTS -->|mif, tma| AGGREGATE
        AGGREGATE -->|mif, backsub, tma| WRITE_SEGMENTATIONS
    end

    subgraph output [Output]
        MERGE_SPATIALDATA([Merge cores])
        PUBLISH_SPATIALDATA([Publish store])

        MERGE_SPATIALDATA -->|tma| PUBLISH_SPATIALDATA
    end

    subgraph qc [Quality control]
        QC_METRICS([QC metrics])
        QC_IMAGES([QC images])
        QC_REPORT([QC report])
        MERGE_REPORT([Slide report])
        COMPARE_SEGMENTATIONS([Compare methods])

        QC_METRICS -->|mif, backsub, tma| QC_REPORT
        QC_IMAGES -->|mif, backsub, tma| QC_REPORT
        QC_METRICS -->|tma| MERGE_REPORT
    end

    %% Between the sections
    ASHLAR -->|mif| TO_SPATIALDATA
    BACKSUB -->|backsub| TO_SPATIALDATA
    COREOGRAPH -->|tma| TO_SPATIALDATA
    MAKE_IMAGE_PATCHES -->|mif, backsub| SEGMENT_PATCH_CELLPOSE
    MAKE_IMAGE_PATCHES -->|mif, tma| SEGMENT_PATCH_INSTANSEG
    WRITE_SEGMENTATIONS -->|mif, backsub| PUBLISH_SPATIALDATA
    WRITE_SEGMENTATIONS -->|tma| MERGE_SPATIALDATA
    WRITE_SEGMENTATIONS -->|mif, backsub, tma| QC_METRICS
    WRITE_SEGMENTATIONS -->|mif, backsub, tma| QC_IMAGES
    WRITE_SEGMENTATIONS -->|mif| COMPARE_SEGMENTATIONS

    %% One edge is missing on purpose. Wherever backsub runs, the pre-subtraction
    %% image also reaches QC_METRICS, so the comparison before and after
    %% subtraction can be made. Adding `ASHLAR -->|backsub| QC_METRICS` aborts
    %% nf-metro 1.1.0's renderer with a CurveInvariantError, "a route hanging in
    %% open space", so it is described in docs/CONTRIBUTING.md instead. The same
    %% holds for ASHLAR's QC directory, which reaches QC_REPORT and MERGE_REPORT.
    %%
    %% The segmentation on each line is an example: any methods and targets fit any line.
    %% A TMA run with backsub is a fourth combination and is not drawn: it would run
    %% COREOGRAPH then BACKSUB, per core. COREOGRAPH precedes BACKSUB in the
    %% subworkflow so that each core is subtracted on its own and keeps an
    %% unsubtracted twin of matching shape for QC to compare against.
