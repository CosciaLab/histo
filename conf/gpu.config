/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU segmentation (use_gpu)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by nextflow.config only when use_gpu is true. Asks for one GPU per Cellpose or
    InstanSeg patch task; conf/slurm.config and conf/mdc.config turn that into SLURM options.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'PATCH_SEGMENTATION_(CELLPOSE|INSTANSEG)' {
        accelerator = 1

        // So one run cannot take every free GPU on a shared cluster.
        maxForks = 16

        // Until the tile-size benchmark (ROADMAP): tiny and small slides get 1 CPU and 8 GB.
        cpus   = { workflow.profile.tokenize(',').any { it in ['size_tiny', 'size_small'] } ? 1 : 2 }
        memory = { (workflow.profile.tokenize(',').any { it in ['size_tiny', 'size_small'] } ? 8.GB : 16.GB) * task.attempt }

        // Mounts the host's CUDA driver into the container. Docker on the Mac has no GPU to pass.
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '' }
    }
}
