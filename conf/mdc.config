/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MDC cluster
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Use with slurm: -profile singularity,size_medium,slurm,mdc
----------------------------------------------------------------------------------------
*/

process {
    // Only nodes with the Ceph storage mounted. With use_gpu, an A40: every A40 node has Ceph, and
    // the sopa image's CUDA 13 has no kernels for the V100s. Replaces slurm.config's untyped gres.
    clusterOptions = { ['--constraint=ceph', task.accelerator ? "--gres=gpu:a40:${task.accelerator.request}" : null].findAll() }
    queue = { task.accelerator ? 'gpu' : null }
}
