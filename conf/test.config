/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Channel wiring of the pre-stitched path, under -stub only: there is no real image.

    Use as follows:
        nextflow run . -profile test,laptop -stub --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h',
    ]
}

params {
    config_profile_name = 'Test profile with Cellpose'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // data_path is "." on purpose: stubs never read it, but the schema needs a path that
    // exists from any launch directory, including nf-test's per-test hash directories.
    input = "${baseDir}/tests/samplesheet.csv"

    // Pre-stitched entry point; the TMA and preprocessing paths have their own stub tests.
    use_preprocessing = false

    // Patches
    patch_width_pixel = 5000
    patch_overlap_pixel = 50

    // Cellpose segmentation
    use_cellpose = true
    cellpose_diameter = 35
    cellpose_channels = 'DAPI'
    flow_threshold = 2
    cellprob_threshold = -6

    // Filtering
    min_area_pixels2 = 2500
}
